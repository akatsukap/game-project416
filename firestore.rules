rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ヘルパー関数: ユーザーが認証されているかチェック
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ヘルパー関数: ユーザーがルームのホストかチェック
    function isHost(roomCode) {
      return isAuthenticated() && 
             request.auth.uid == get(/databases/$(database)/documents/game_rooms/$(roomCode)).data.hostId;
    }
    
    // ヘルパー関数: ユーザーがルームの参加者かチェック
    function isParticipant(roomCode) {
      return isAuthenticated() && 
             request.auth.uid in get(/databases/$(database)/documents/game_rooms/$(roomCode)).data.playerIds;
    }
    
    // ゲームルームへのアクセス制御
    match /game_rooms/{roomCode} {
      // 誰でも読み取り可能（認証済みユーザーのみ）
      allow read: if isAuthenticated();
      
      // 認証済みユーザーは新しいルームを作成可能
      allow create: if isAuthenticated() &&
                       request.resource.data.hostId == request.auth.uid &&
                       request.resource.data.playerIds.size() >= 1 &&
                       request.auth.uid in request.resource.data.playerIds;
      
      // ホストのみがルームを削除可能
      allow delete: if isHost(roomCode);
      
      // 参加プレイヤーのみがルームを更新可能
      // ただし、以下の条件を満たす必要がある：
      // - ホストIDは変更できない（ホスト移譲の場合を除く）
      // - maxPlayersは変更できない
      // - roomCodeは変更できない
      allow update: if isParticipant(roomCode) &&
                       // ホスト移譲の場合：新しいホストは参加者リストに含まれている必要がある
                       (request.resource.data.hostId == resource.data.hostId ||
                        (request.resource.data.hostId in resource.data.playerIds)) &&
                       // maxPlayersは変更不可
                       request.resource.data.maxPlayers == resource.data.maxPlayers &&
                       // roomCodeは変更不可
                       request.resource.data.roomCode == resource.data.roomCode;
      
      // ゲーム状態サブコレクションへのアクセス
      match /game_state/{document} {
        // 参加プレイヤーのみが読み取り可能
        allow read: if isAuthenticated() && isParticipant(roomCode);
        
        // 参加プレイヤーのみが書き込み可能
        allow write: if isAuthenticated() && isParticipant(roomCode);
      }
    }
  }
}
